# Python — bytecode, build output, tool caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/

# uv: the lockfile is committed; the environment is not.

# Environment & secrets
.env
.env.*

# Node — the web console's dependencies and build output (`dist/` above covers
# web/dist); package-lock.json IS committed so a build is reproducible.
node_modules/
web/.vite/
*.local

# Run artifacts
logs/
runs/
*.log

# OS & editors
.DS_Store
.vscode/
.idea/
